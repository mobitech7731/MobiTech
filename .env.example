# ========================================================
# MOBITECH MONOREPO ENVIRONMENT VARIABLES
# ========================================================
# Note: For development, variables are split between:
# - Backend configuration: server/.env
# - Frontend configuration: client/.env
# ========================================================

# --------------------------------------------------------
# BACKEND CONFIGURATION (server/.env)
# --------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/mobitech

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=7d

# Initial Admin Seed Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=Admin

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --------------------------------------------------------
# FRONTEND CONFIGURATION (client/.env)
# --------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_WHATSAPP_NUMBER=your_business_whatsapp_number
